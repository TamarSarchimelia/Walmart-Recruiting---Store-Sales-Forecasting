22201, 3)\n","(39414, 3)\n","(42260, 3)\n"]}],"source":["import pandas as pd\n","import numpy as np\n","\n","from itertools import product\n","\n","import mlflow\n","\n","from neuralforecast import NeuralForecast\n","from neuralforecast.models import PatchTST\n","\n","from pytorch_lightning.callbacks import Callback\n","\n","\n","\n","def load_data(train_path, stores_path, features_path):\n","\n","    train = pd.read_csv(train_path)\n","    stores = pd.read_csv(stores_path)\n","    features = pd.read_csv(features_path)\n","\n","\n","    train[\"Date\"] = pd.to_datetime(train[\"Date\"])\n","    features[\"Date\"] = pd.to_datetime(features[\"Date\"])\n","\n","\n","    df = train.merge(\n","        stores,\n","        on=\"Store\",\n","        how=\"left\"\n","    )\n","\n","\n","    df = df.merge(\n","        features,\n","        on=[\n","            \"Store\",\n","            \"Date\",\n","            \"IsHoliday\"\n","        ],\n","        how=\"left\"\n","    )\n","\n","\n","    return df\n","\n","\n","\n","\n","def preprocess_data(df):\n","\n","    df = df.sort_values(\n","        [\n","            \"Store\",\n","            \"Dept\",\n","            \"Date\"\n","        ]\n","    ).reset_index(drop=True)\n","\n","\n","\n","    # date features\n","\n","    df[\"Year\"] = df[\"Date\"].dt.year\n","\n","    df[\"Month\"] = df[\"Date\"].dt.month\n","\n","    df[\"Week\"] = (\n","        df[\"Date\"]\n","        .dt.isocalendar()\n","        .week\n","        .astype(int)\n","    )\n","\n","    df[\"Quarter\"] = df[\"Date\"].dt.quarter\n","\n","\n","\n","    df[\"IsHoliday\"] = (\n","        df[\"IsHoliday\"]\n","        .astype(int)\n","    )\n","\n","\n","\n","\n","    markdown_cols = [\n","        \"MarkDown1\",\n","        \"MarkDown2\",\n","        \"MarkDown3\",\n","        \"MarkDown4\",\n","        \"MarkDown5\"\n","    ]\n","\n","\n","    for col in markdown_cols:\n","\n","        if col in df.columns:\n","\n","            df[col] = (\n","                df[col]\n","                .fillna(0)\n","            )\n","\n","\n","\n","    numeric_cols = (\n","        df\n","        .select_dtypes(include=\"number\")\n","        .columns\n","    )\n","\n","\n","    df[numeric_cols] = (\n","        df[numeric_cols]\n","        .fillna(\n","            df[numeric_cols].median()\n","        )\n","    )\n","\n","\n","    return df\n","\n","\n","\n","def create_patchtst_dataframe(df):\n","\n","    df = df.rename(\n","        columns={\n","            \"Date\":\"ds\",\n","            \"Weekly_Sales\":\"y\"\n","        }\n","    )\n","\n","\n","    df[\"unique_id\"] = (\n","        df[\"Store\"].astype(str)\n","        +\n","        \"_\"\n","        +\n","        df[\"Dept\"].astype(str)\n","    )\n","\n","\n","    df = df.sort_values(\n","        [\n","            \"unique_id\",\n","            \"ds\"\n","        ]\n","    )\n","\n","\n","    return df\n","\n","\n","\n","def split_data(\n","    df,\n","    train_ratio=0.8,\n","    val_ratio=0.9\n","):\n","\n","    split1 = df[\"ds\"].quantile(\n","        train_ratio\n","    )\n","\n","    split2 = df[\"ds\"].quantile(\n","        val_ratio\n","    )\n","\n","\n","    train_df = df[\n","        df[\"ds\"] < split1\n","    ].copy()\n","\n","\n","    val_df = df[\n","        (df[\"ds\"] >= split1)\n","        &\n","        (df[\"ds\"] < split2)\n","    ].copy()\n","\n","\n","    test_df = df[\n","        df[\"ds\"] >= split2\n","    ].copy()\n","\n","\n","\n","\n","    train_ids = set(\n","        train_df[\"unique_id\"]\n","    )\n","\n","\n","    val_df = val_df[\n","        val_df[\"unique_id\"]\n","        .isin(train_ids)\n","    ]\n","\n","\n","    test_df = test_df[\n","        test_df[\"unique_id\"]\n","        .isin(train_ids)\n","    ]\n","\n","\n","    return (\n","        train_df,\n","        val_df,\n","        test_df\n","    )\n","\n","\n","\n","def prepare_patchtst_data(\n","    train_df,\n","    val_df,\n","    test_df,\n","    input_size=78,\n","    val_size=14\n","):\n","\n","    columns = [\n","        \"unique_id\",\n","        \"ds\",\n","        \"y\"\n","    ]\n","\n","    train_df = train_df[columns].copy()\n","    val_df = val_df[columns].copy()\n","    test_df = test_df[columns].copy()\n","\n","\n","    min_length = input_size + val_size\n","\n","\n","    series_length = (\n","        train_df\n","        .groupby(\"unique_id\")\n","        .size()\n","    )\n","\n","\n","    valid_series = series_length[\n","        series_length >= min_length\n","    ].index\n","\n","\n","    train_df = train_df[\n","        train_df.unique_id.isin(valid_series)\n","    ]\n","\n","    val_df = val_df[\n","        val_df.unique_id.isin(valid_series)\n","    ]\n","\n","    test_df = test_df[\n","        test_df.unique_id.isin(valid_series)\n","    ]\n","\n","\n","    print(\"Series:\", len(valid_series))\n","    print(\n","        \"Shortest:\",\n","        train_df.groupby(\"unique_id\").size().min()\n","    )\n","\n","\n","    return train_df, val_df, test_df\n","\n","\n","\n","df = load_data(\n","    \"train.csv\",\n","    \"stores.csv\",\n","    \"features.csv\"\n",")\n","\n","\n","df = preprocess_data(df)\n","\n","\n","patch_df = create_patchtst_dataframe(df)\n","\n","\n","\n","train_df, val_df, test_df = split_data(\n","    patch_df\n",")\n","\n","\n","\n","INPUT_SIZE = 78\n","\n","\n","train_df, val_df, test_df = prepare_patchtst_data(\n","    train_df,\n","    val_df,\n","    test_df,\n","    input_size=78,\n","    val_size=14\n",")\n","\n","\n","\n","print(train_df.shape)\n","print(val_df.shape)\n","print(test_df.shape)\n","\n","\n","\n","\n","\n","history_features = [\n","    \"IsHoliday\",\n","    \"Month\",\n","    \"Week\",\n","    \"Quarter\",\n","\n","    \"Temperature\",\n","    \"Fuel_Price\",\n","    \"CPI\",\n","    \"Unemployment\",\n","\n","    \"MarkDown1\",\n","    \"MarkDown2\",\n","    \"MarkDown3\",\n","    \"MarkDown4\",\n","    \"MarkDown5\"\n","]\n","\n","\n","static_features = [\n","    \"Type\",\n","    \"Size\"\n","]\n","\n","\n","\n","class MLflowLossCallback(Callback):\n","\n","    def on_train_epoch_end(\n","        self,\n","        trainer,\n","        pl_module\n","    ):\n","\n","        for name,value in trainer.callback_metrics.items():\n","\n","            if \"loss\" in name:\n","\n","                mlflow.log_metric(\n","                    \"train_\"+name,\n","                    value.item(),\n","                    step=trainer.current_epoch\n","                )\n","\n","\n","    def on_validation_epoch_end(\n","        self,\n","        trainer,\n","        pl_module\n","    ):\n","\n","        for name,value in trainer.callback_metrics.items():\n","\n","            if \"loss\" in name:\n","\n","                mlflow.log_metric(\n","                    \"val_\"+name,\n","                    value.item(),\n","                    step=trainer.current_epoch\n","                )\n","\n","\n","loss_callback = MLflowLossCallback()\n","\n","\n","\n"]},{"cell_type":"code","source":["\n","from itertools import product\n","import mlflow\n","import numpy as np\n","from neuralforecast import NeuralForecast\n","from neuralforecast.models import PatchTST\n","\n","\n","from itertools import product\n","\n","configs = list(product(\n","    [1e-2, 1e-3, 5e-4],   # learning_rate\n","    [32, 64, 128],        # batch_size\n","    [500, 1000, 1500]     # max_steps\n","))\n","\n","print(len(configs))\n","\n","\n","for learning_rate, batch_size, max_steps in configs:\n","\n","    run_name = (\n","        f\"PatchTST_learning_rate{learning_rate}\"\n","        f\"_batch_size{batch_size}\"\n","        f\"_max_steps{max_steps}\"\n","    )\n","\n","    print(\"=\"*60)\n","    print(run_name)\n","\n","\n","    with mlflow.start_run(run_name=run_name):\n","\n","\n","        mlflow.log_params({\n","\n","            \"model\": \"PatchTST\",\n","            \"hidden_size\": 128,\n","            \"n_heads\": 4,\n","            \"encoder_layers\": 1,\n","\n","            \"in